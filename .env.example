PORT=3000
# Ganti dengan kata sandi admin guru yang kuat sebelum aplikasi dipakai.
TEACHER_PASSWORD=GantiDenganPasswordKuat
# Opsional: API OpenAI-kompatibel. Jika kosong, aplikasi menjawab dari materi yang ditemukan.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
# Ganti agar cookie sesi lebih aman; minimal 32 karakter acak.
SESSION_SECRET=GantiDenganRahasiaAcakPanjangMinimal32Karakter
MAX_UPLOAD_MB=12
